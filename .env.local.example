# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ====== App Config ======
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=ID
NEXT_PUBLIC_DEFAULT_LOCALE=id

# ====== Public RSVP (Sprint 9) ======
# Server-only go-live switch for the public RSVP link (no NEXT_PUBLIC_ variant).
# "true" (case/whitespace-insensitive) = on; anything else or unset = off.
# Staging: true. Prod: false until RSVP go-live.
RSVP_PUBLIC_ENABLED=true
# Server-only (never NEXT_PUBLIC_): the p_gate value submit_rsvp checks against
# the Supabase vault secret 'rsvp_gate'. Must match the vault of the project
# this deployment talks to — Vercel Preview = staging vault value, Production
# = prod vault value. Local Docker: the supabase/seed.sql placeholder literal.
# Unset/blank -> public submissions fail closed ("unavailable").
RSVP_GATE_SECRET=
# S9-R4 invisible Cloudflare Turnstile on the public RSVP form. Server-only
# toggle, same truthiness rule as RSVP_PUBLIC_ENABLED. When "true", BOTH keys
# must be set or submissions fail closed ("unavailable"). The site key is
# passed to the form by the page — there is no NEXT_PUBLIC_ variant.
RSVP_TURNSTILE_ENABLED=false
RSVP_TURNSTILE_SITE_KEY=
RSVP_TURNSTILE_SECRET_KEY=

# ====== Telegram (Sprint 4) ======
# Admin chat ID is NOT an env var — it lives in app_settings.telegram_admin_chat_id (C/1).
TELEGRAM_BOT_TOKEN=

# ====== Notify SMTP (Sprint 4, T8) ======
# Same Gmail account as Supabase Auth SMTP (project37.events@gmail.com, A/1 —
# shared sender accepted for Sprint 4), but a SECOND, separately-named App
# Password ("Project 37 — notify SMTP") so it's independently revocable.
# 587/STARTTLS chosen over 465/implicit-TLS — more firewall-friendly.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=sample.events@gmail.com
NOTIFY_SMTP_PASS=
NOTIFY_FROM_NAME=Project 37
NOTIFY_REPLY_TO=

# ====== Cron Secret (Sprint 2+) ======
CRON_SECRET=