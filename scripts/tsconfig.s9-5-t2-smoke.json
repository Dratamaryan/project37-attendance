{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "./.build",
    "rootDir": "..",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "s9-5/t2-staging-smoke.ts"
  ],
  "exclude": ["**/__tests__/**"]
}
