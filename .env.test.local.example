# Copy to .env.test.local (gitignored). Vitest's mode='test' loads this file
# LAST (see vitest.config.ts), so it overrides .env.local's values for `npm
# test` only — this is what keeps integration tests off prod even when
# .env.local itself resolves to a real project.
#
# Values below are the Supabase CLI's well-known local demo keys — identical
# on every machine running `supabase start` with this repo's
# supabase/config.toml (project_id=project37-rewrite, ports offset +100 from
# the CLI defaults so this stack never collides with any other local Supabase
# project already running on the same machine). Not secrets — safe to commit
# as literal example values, but regenerate via `supabase status -o env` if
# config.toml's ports ever change.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
